{
  "expo": {
    "name": "GeoTax",
    "slug": "tax-survey-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "taxsurvey",
    "ios": {
      "bundleIdentifier": "com.taxofficer.surveyapp",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "يستخدم التطبيق موقعك لتسجيل إحداثيات النشاط أثناء المعاينة.",
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لالتقاط صور النشاط أثناء المعاينة.",
        "NSPhotoLibraryUsageDescription": "يستخدم التطبيق مكتبة الصور لإرفاق صور النشاط.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.taxofficer.surveyapp",
      "adaptiveIcon": {
        "backgroundColor": "#0E7C66",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E7C66",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم التطبيق موقعك لتسجيل إحداثيات النشاط أثناء المعاينة."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم التطبيق مكتبة الصور لإرفاق صور النشاط.",
          "cameraPermission": "يستخدم التطبيق الكاميرا لالتقاط صور النشاط أثناء المعاينة.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "privacyPolicyUrl": "https://abdallahragab40.github.io/geotax/privacy-policy.html",
      "eas": {
        "projectId": "8900c043-a5d3-407d-bc04-b3d7cbe8d37b"
      }
    },
    "owner": "abdallahragab"
  }
}
