# انسخ هذا الملف إلى .env واملأ القيم من حساباتك

# من: Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# (اختياري) مزوّد بلاطات الخريطة للإنتاج — بدون قيمة يُستخدم OpenStreetMap
# EXPO_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# EXPO_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# (اختياري) رابط سياسة الخصوصية إن استضفتها في مكان آخر غير GitHub Pages
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://example.com/privacy

